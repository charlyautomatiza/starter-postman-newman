{
  "name": "starter-postman-newman",
  "version": "1.0.0",
  "description": "postman newman runner",
  "main": "main.ts",
  "scripts": {
    "clean": "rimraf ./newman",
    "test": "npm run clean && npx ts-node ./src/main.ts",
    "test:prod": "npm run clean && newman run src/collections/postman_echo.postman_collection.json --bail --reporters cli,htmlextra,junit --reporter-htmlextra-export newman/report.html --reporter-junit-export newman/results.xml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlyautomatiza/starter-postman-newman.git"
  },
  "keywords": [
    "postman",
    "newman",
    "testautomation"
  ],
  "author": "Charly Automatiza",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/charlyautomatiza/starter-postman-newman/issues"
  },
  "homepage": "https://github.com/charlyautomatiza/starter-postman-newman#readme",
  "dependencies": {
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/newman": "^5.3.6",
    "@types/node": "^22.19.0"
  }
}
